# Copia este archivo como .env y completa los valores de tu entorno.
# El proyecto no carga .env automáticamente; configura las variables en el sistema
# o añade python-dotenv si deseas cargarlas desde archivo.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Para PostgreSQL: DJANGO_DB_ENGINE=postgresql
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_NAME=alke_wallet
DJANGO_DB_USER=alke_user
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
